# ============================================================================
# Salin file ini menjadi .env.local lalu isi nilainya.
#   cp .env.example .env.local
#
# Aplikasi tetap bisa jalan TANPA mengisi apa pun (MODE DEMO): pembayaran &
# email akan disimulasikan. Isi variabel di bawah untuk mengaktifkan mode asli.
# ============================================================================

# ---- Midtrans (pembayaran QRIS) -------------------------------------------
# Dapatkan dari Dashboard Midtrans: Settings -> Access Keys
# Kosongkan untuk MODE DEMO (tanpa pembayaran asli).
MIDTRANS_SERVER_KEY=
# "true" untuk environment production, "false" / kosong untuk sandbox.
MIDTRANS_IS_PRODUCTION=false

# ---- Email (SMTP) — pengiriman link produk --------------------------------
# Contoh Gmail: aktifkan 2FA lalu buat "App Password" 16 digit.
# Kosongkan untuk MODE DEV (email hanya di-log ke console).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Digital Creatif <no-reply@digitalcreatif.id>"

# ---- Link produk (rahasia, dikirim setelah bayar) -------------------------
# Ganti dengan link download asli (Google Drive/S3/dll). Opsional —
# default placeholder dipakai bila kosong.
PRODUCT_LINK_LANDING_SAAS=
PRODUCT_LINK_PORTFOLIO_MINIMAL=
PRODUCT_LINK_ECOMMERCE_STARTER=
PRODUCT_LINK_NOTION_BUNDLE=
